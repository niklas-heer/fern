type Name = String
newtype Id = Id(Int)
fn unwrap(Id(value): Id) -> Int: value
type Choice = Int | String
fn size(value:Choice)->Int:
    match value:
        number:Int -> number
        _:String -> 0
type Entry:
    count: Int
fn workflow() -> Result(Int, String):
    defer println("done")
    let original = Entry(0)
    let updated = %{original | count: 1}
    let values = %{"x": updated.count}
    for index in 0..=1:
        continue if index == 0
        break
    with
        value <- Ok(Map.len(values))
    do
        Ok(value)
    else
        Err(message) -> Err(message)
fn following() -> Int: 1
fn label_probe(external local:Int)->Int:local
fn label_usage()->Int:7 |> label_probe(external:_)
