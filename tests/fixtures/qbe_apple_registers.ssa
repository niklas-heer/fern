export function l $rotate(l %n, l %a, l %b) {
@start
    jmp @loop
@loop
    %x =l phi @start %a, @next %y
    %y =l phi @start %b, @next %x
    %i =l phi @start %n, @next %j
    jnz %i, @next, @done
@next
    %j =l sub %i, 1
    jmp @loop
@done
    %result =l sub %x, %y
    ret %result
}

export function d $rotate_float(l %n, d %a, d %b) {
@start
    jmp @loop
@loop
    %x =d phi @start %a, @next %y
    %y =d phi @start %b, @next %x
    %i =l phi @start %n, @next %j
    jnz %i, @next, @done
@next
    %j =l sub %i, 1
    jmp @loop
@done
    %result =d sub %x, %y
    ret %result
}

