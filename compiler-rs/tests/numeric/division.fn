fn divide(a: Int, b: Int) -> Int: a / b
fn remainder(a: Int, b: Int) -> Int: a % b
fn main():
    println(divide(-7, 2))
    println(remainder(-7, 2))
    println(divide(7, -2))
    println(remainder(7, -2))
    println(divide(-9223372036854775808, -1))
    println(remainder(-9223372036854775808, -1))
