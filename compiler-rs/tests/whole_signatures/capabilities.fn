fn add(left, right) -> left + right
fn square(value) -> value * value
fn describe(value) -> "value={value}"
fn seen(value) -> List.contains([value], value)
fn lookup(key, value) -> Map.get(%{key: value}, key)
fn main():
    println(add(20, 22))
    println(add(1.25, 2.5))
    println(add("Fer", "n"))
    println(square(3))
    println(square(2.0))
    println(describe(true))
    println(seen("Fern"))
    println(Option.unwrap_or(lookup("answer", 42), 0))
