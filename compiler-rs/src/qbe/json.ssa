# Checked bridge from compiler-owned Map pairs (key64,value64), evaluated once.
function l $fern_rs_json_object(l %map) {
@start
    %len =l call $fern_list_len(l %map)
    %negative =w csltl %len, 0
    %large =w csgtl %len, 49999
    %bad =w or %negative, %large
    jnz %bad, @error, @allocate
@error
    %failure =l call $fern_json_value_limit_error()
    ret %failure
@allocate
    %empty =w ceql %len, 0
    %extra =l extuw %empty
    %capacity =l add %len, %extra
    %keys =l call $fern_list_with_capacity(l %capacity)
    %values =l call $fern_list_with_capacity(l %capacity)
    jmp @loop
@loop
    %i =l phi @allocate 0, @step %next
    %more =w csltl %i, %len
    jnz %more, @read, @done
@read
    %pair =l call $fern_list_get(l %map, l %i)
    %key =l loadl %pair
    %slot =l add %pair, 8
    %value =l loadl %slot
    call $fern_list_push_mut(l %keys, l %key)
    call $fern_list_push_mut(l %values, l %value)
    jmp @step
@step
    %next =l add %i, 1
    jmp @loop
@done
    %result =l call $fern_json_value_from_object(l %keys, l %values)
    ret %result
}

# Inspect Result before touching List(Member*) and bridge each two-word record.
function l $fern_rs_json_members(l %result) {
@start
    %ok =w call $fern_result_is_ok(l %result)
    jnz %ok, @allocate, @failed
@failed
    ret %result
@allocate
    %native =l call $fern_result_unwrap(l %result)
    %len =l call $fern_list_len(l %native)
    %empty =w ceql %len, 0
    %extra =l extuw %empty
    %capacity =l add %len, %extra
    %list =l call $fern_list_with_capacity(l %capacity)
    jmp @loop
@loop
    %i =l phi @allocate 0, @step %next
    %more =w csltl %i, %len
    jnz %more, @read, @done
@read
    %member =l call $fern_list_get(l %native, l %i)
    %key =l loadl %member
    %slot =l add %member, 8
    %value =l loadl %slot
    %tuple =l call $fern_alloc(l 24)
    storel 0, %tuple
    %first =l add %tuple, 8
    storel %key, %first
    %second =l add %tuple, 16
    storel %value, %second
    call $fern_list_push_mut(l %list, l %tuple)
    jmp @step
@step
    %next =l add %i, 1
    jmp @loop
@done
    %converted =l call $fern_result_ok(l %list)
    ret %converted
}
