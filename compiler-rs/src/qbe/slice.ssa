# The nonallocating runtime predicate shares its clamping rules with the slice.
function l $fern_rs_string_slice(l %fault, l %source, l %start, l %end) {
@start
    %valid =l call $fern_str_slice_is_valid(l %source, l %start, l %end)
    jnz %valid, @slice, @invalid
@invalid
    storel 6, %fault
    ret 0
@slice
    %value =l call $fern_str_slice(l %source, l %start, l %end)
    ret %value
}
