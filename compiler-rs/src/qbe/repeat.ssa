data $fern_rs_empty_string = { b 0 }
# Bound content to 16 MiB using division, avoiding multiplication overflow entirely.
function l $fern_rs_string_repeat(l %fault, l %source, l %count) {
@start
    %nonpositive =w cslel %count, 0
    jnz %nonpositive, @empty, @length
@length
    %size =l call $fern_str_len(l %source)
    %is_empty =w ceql %size, 0
    jnz %is_empty, @empty, @limit
@empty
    ret $fern_rs_empty_string
@limit
    %allowed =l udiv 16777216, %size
    %too_large =w csgtl %count, %allowed
    jnz %too_large, @invalid, @repeat
@invalid
    storel 5, %fault
    ret 0
@repeat
    %value =l call $fern_str_repeat(l %source, l %count)
    ret %value
}
