# The caller has proved 0 < offset <= list length before selecting this arm.
function l $fern_rs_pattern_tail(l %source, l %offset) {
@start
    %length =l call $fern_list_len(l %source)
    %remaining =l sub %length, %offset
    %nonempty =w csgtl %remaining, 0
    jnz %nonempty, @capacity, @empty
@capacity
    jmp @allocate
@empty
    jmp @allocate
@allocate
    %capacity =l phi @capacity %remaining, @empty 1
    %output =l call $fern_list_with_capacity(l %capacity)
    jmp @loop
@loop
    %index =l phi @allocate %offset, @body %next
    %more =w csltl %index, %length
    jnz %more, @body, @done
@body
    %item =l call $fern_list_get(l %source, l %index)
    call $fern_list_push_mut(l %output, l %item)
    %next =l add %index, 1
    jmp @loop
@done
    ret %output
}
