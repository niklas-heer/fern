# Conditional expressions example
# Demonstrates if/else and nested conditionals

fn abs(n: Int) -> Int:
    if n < 0: 0 - n
    else: n

fn max(a: Int, b: Int) -> Int:
    if a > b: a
    else: b

fn min(a: Int, b: Int) -> Int:
    if a < b: a
    else: b

fn clamp(value: Int, lo: Int, hi: Int) -> Int:
    if value < lo: lo
    else: if value > hi: hi
    else: value

fn main():
    # Test abs
    println(abs(5))
    println(abs(0 - 5))

    # Test max/min
    println(max(a: 10, b: 20))
    println(min(a: 10, b: 20))

    # Test clamp
    println(clamp(value: 5, lo: 0, hi: 10))
    println(clamp(value: 0 - 5, lo: 0, hi: 10))
    println(clamp(value: 15, lo: 0, hi: 10))
