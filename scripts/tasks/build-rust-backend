#!/usr/bin/env bash
# Build both compiler-owned native adapters using the literal authored flag record.
set -euo pipefail
[[ $# == 0 ]] || { echo 'unexpected backend build arguments' >&2; exit 2; }
source "$(dirname "$0")/build-arguments"
cc="$(/bin/bash scripts/build_config cc)"
build_configuration_words base_cflags
base=(${build_words[@]+"${build_words[@]}"})
"$cc" ${base[@]+"${base[@]}"} compiler-rs/backend/qbe_driver.c build/qbe_*.o -lm -o bin/fern-qbe
"$cc" ${base[@]+"${base[@]}"} tools/test_supervisor.c -o bin/fern-test-supervisor
