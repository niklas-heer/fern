# Literal flag records for mise build helpers; no eval, expansion or compiler bootstrap.

# Decode lexical quotes/escapes into the global array; publish only a complete record.
# Records are bounded before scanning; each word and the aggregate count are bounded too.
build_decode_words() {
    local record=$1 word= quote= byte= present=0 index chunk length
    local LC_ALL=C
    local size=${#record}
    local -a decoded=()
    build_words=()
    for ((index=0; index<size; index++)); do
        chunk=${record:index:256}
        if build_literal_chunk "$chunk" "$quote"; then
            length=${#chunk}
            ((${#word} <= 16384 - length)) || return 2
            word+=$chunk; present=1; index=$((index + length - 1))
            continue
        fi
        byte=${record:index:1}
        if [[ $quote == "'" ]]; then
            if [[ $byte == "'" ]]; then quote=; continue; fi
        elif [[ $byte == '\' ]]; then
            index=$((index + 1))
            ((index < size)) || return 2
            byte=${record:index:1}
        elif [[ $quote == '"' ]]; then
            if [[ $byte == '"' ]]; then quote=; continue; fi
        elif [[ $byte == "'" || $byte == '"' ]]; then
            quote=$byte; present=1; continue
        elif [[ $byte == ' ' || $byte == $'\t' ]]; then
            if ((present)); then
                ((${#decoded[@]} < 4096)) || return 2
                decoded+=("$word"); word=; present=0
            fi
            continue
        fi
        ((${#word} < 16384)) || return 2
        word+=$byte; present=1
    done
    [[ -z $quote ]] || return 2
    if ((present)); then
        ((${#decoded[@]} < 4096)) || return 2
        decoded+=("$word")
    fi
    build_words=(${decoded[@]+"${decoded[@]}"})
}

# Copy plain spans in bounded chunks, avoiding quadratic per-byte long-word construction.
# Quotes and escapes still use the single-byte state machine at every boundary.
build_literal_chunk() {
    case $2 in
        "'") [[ $1 != *"'"* ]] ;;
        '"') [[ $1 != *'"'* && $1 != *'\'* ]] ;;
        *) [[ $1 != *"'"* && $1 != *'"'* && $1 != *'\'* && $1 != *' '* && $1 != *$'\t'* ]] ;;
    esac
}

# Read at most 65537 bytes; NUL, CR, multiple records and oversized input fail closed.
# A single trailing newline is the record delimiter, never part of an argument.
build_words_file() {
    local record= LC_ALL=C
    build_words=()
    [[ -f $1 && -r $1 ]] || return 2
    if IFS= read -r -d '' -n 65537 record < "$1"; then
        printf '%s\n' 'invalid build arguments: NUL or record limit' >&2
        return 2
    fi
    ((${#record} <= 65536)) || return 2
    record=${record%$'\n'}
    if [[ $record == *$'\r'* || $record == *$'\n'* ]] || ! build_decode_words "$record"; then
        printf '%s\n' 'invalid build arguments: quoting, control byte or word limit' >&2
        return 2
    fi
}

# Capture trusted configuration/pkg-config output without losing NULs or command status.
# Only the owned temporary file is removed; failed parsing never invokes a compiler.
build_capture_words() {
    local temporary status
    build_words=()
    temporary=$(mktemp "${TMPDIR:-/tmp}/fern-build-arguments.XXXXXXXX") || return 2
    if "$@" > "$temporary"; then
        if build_words_file "$temporary"; then status=0; else status=$?; fi
    else
        status=$?
    fi
    rm -f -- "$temporary"
    return "$status"
}

# Read one authored flag field through the same bounded lexical contract.
build_configuration_words() {
    build_capture_words /bin/bash scripts/build_config "$1"
}
