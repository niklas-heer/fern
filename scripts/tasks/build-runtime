#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "$0")/build-arguments"
[[ $# == 1 ]] || { echo "expected debug or release mode" >&2; exit 2; }
mode="$1"
case "$mode" in
  debug) build_configuration_words debug_flags; mode_flags=(${build_words[@]+"${build_words[@]}"}) ;;
  release) build_configuration_words release_flags; mode_flags=(${build_words[@]+"${build_words[@]}"}) ;;
  *) echo "Unknown build mode: $mode"; exit 1 ;;
esac
cc="$(/bin/bash scripts/build_config cc)"
build_configuration_words base_cflags; base=(${build_words[@]+"${build_words[@]}"})
build_configuration_words linenoise_cflags; linenoise=(${build_words[@]+"${build_words[@]}"})
build_configuration_words civetweb_cflags; civetweb=(${build_words[@]+"${build_words[@]}"})
gc_cflags=()
if pkg-config --exists bdw-gc >/dev/null 2>&1; then
  build_capture_words pkg-config --cflags bdw-gc
  gc_cflags=(${build_words[@]+"${build_words[@]}"})
fi
openssl_cflags=()
if pkg-config --exists openssl >/dev/null 2>&1; then
  build_capture_words pkg-config --cflags openssl
  openssl_cflags=(${build_words[@]+"${build_words[@]}"})
fi
mkdir -p build bin
runtime_objs=()
for src in $(/bin/bash scripts/build_config runtime_sources); do
  obj="build/runtime_$(basename "${src%.c}").o"
  "$cc" ${base[@]+"${base[@]}"} ${mode_flags[@]+"${mode_flags[@]}"} ${gc_cflags[@]+"${gc_cflags[@]}"} -Iruntime -Ideps/civetweb/include -c "$src" -o "$obj"
  runtime_objs+=("$obj")
done
"$cc" ${civetweb[@]+"${civetweb[@]}"} ${mode_flags[@]+"${mode_flags[@]}"} ${openssl_cflags[@]+"${openssl_cflags[@]}"} -c deps/civetweb/src/civetweb.c -o build/runtime_civetweb.o
runtime_objs+=("build/runtime_civetweb.o")
"$cc" ${linenoise[@]+"${linenoise[@]}"} ${mode_flags[@]+"${mode_flags[@]}"} -c deps/linenoise/linenoise.c -o build/runtime_linenoise.o
runtime_objs+=("build/runtime_linenoise.o")
ar rcs bin/libfern_runtime.a ${runtime_objs[@]+"${runtime_objs[@]}"}
echo "✓ Built runtime library: bin/libfern_runtime.a"
