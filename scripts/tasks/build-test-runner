#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "$0")/build-arguments"
[[ $# == 1 ]] || { echo "expected debug or release mode" >&2; exit 2; }
mode="$1"
case "$mode" in
  debug) build_configuration_words debug_flags; mode_flags=(${build_words[@]+"${build_words[@]}"}) ;;
  release) build_configuration_words release_flags; mode_flags=(${build_words[@]+"${build_words[@]}"}) ;;
  *) echo "Unknown build mode: $mode"; exit 1 ;;
esac
cc="$(/bin/bash scripts/build_config cc)"
build_configuration_words base_cflags; base=(${build_words[@]+"${build_words[@]}"})
mkdir -p build bin
test_objs=()
for src in $(/bin/bash scripts/build_config test_sources); do
  obj="build/test_$(basename "${src%.c}").o"
  "$cc" ${base[@]+"${base[@]}"} ${mode_flags[@]+"${mode_flags[@]}"} -c "$src" -o "$obj"
  test_objs+=("$obj")
done
"$cc" ${base[@]+"${base[@]}"} ${mode_flags[@]+"${mode_flags[@]}"} -c tests/fuzz/fuzz_generator.c -o build/fuzz_generator_test.o
lib_objs=()
for src in $(/bin/bash scripts/build_config lib_sources); do
  lib_objs+=("build/lib_$(basename "${src%.c}").o")
done
"$cc" ${base[@]+"${base[@]}"} ${mode_flags[@]+"${mode_flags[@]}"} -o bin/test_runner \
  ${test_objs[@]+"${test_objs[@]}"} ${lib_objs[@]+"${lib_objs[@]}"} build/linenoise.o build/fuzz_generator_test.o -lm
echo "✓ Built test runner: bin/test_runner"
