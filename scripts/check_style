#!/bin/bash
# Native Fern style checker with content-validated private C-bootstrap artifacts.
set -o pipefail
style_control= style_control_identity= style_run= style_run_identity=
style_original_umask=$(umask)
umask 077
style_original_locale=${LC_ALL-}
style_locale_set=${LC_ALL+x}
export LC_ALL=C
style_root=$(cd -P -- "${BASH_SOURCE[0]%/*}/.." && pwd) || exit 125
style_original_path=$PATH
style_tool_path=${FERN_STYLE_TOOL_PATH-$PATH}
export PATH=$style_tool_path
source "$style_root/scripts/bootstrap/style_common.sh" || exit 125
style_close_descriptors || exit 125
for style_module in inputs cache publish cleanup flags; do
    source "$style_root/scripts/bootstrap/style_$style_module.sh" || exit 125
done

# Report bootstrap failure even when stderr is unavailable; never execute an older cache entry.
style_die() {
    printf 'fern style: native checker bootstrap failed\n' >&2 || :
    exit 125
}

# Restore caller-visible process settings after all private bootstrap work.
style_restore() {
    umask "$style_original_umask" || return 125
    export PATH=$style_original_path
    if [[ $style_locale_set == x ]]; then export LC_ALL=$style_original_locale; else unset LC_ALL; fi
}

trap style_entry_exit EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP
style_driver_environment || style_die
style_tools_init || style_die
style_requested_cache=${FERN_STYLE_CACHE-${XDG_CACHE_HOME:-${HOME:?}/.cache}/fern-style}
style_cache_root "$style_requested_cache" || style_die
style_work_create || style_die
style_control=$style_work
style_control_identity=$style_work_identity
mkdir -m 700 "$style_control/payload" || style_die
style_work=$style_control/payload
style_base_manifest "$style_work/base" || style_die
if style_lookup; then
    style_prune || style_die
    style_control_remove || style_die
    style_restore || style_die
    exec "$style_run/supervisor" --run "$style_run" -- "$style_run/program" "$@"
    style_die
else
    style_lookup_code=$?
    [[ $style_lookup_code == 1 ]] || style_die
fi
style_snapshot_create || style_die
style_snapshot_verify || style_restart_snapshot || style_die
if ! style_seed_compile < /dev/null > "$style_control/seed.stdout" 2> "$style_control/seed.stderr"; then
    /usr/bin/head -c 4096 "$style_control/seed.stderr" >&2 || :
    style_die
fi
/bin/cp -- "$style_snapshot/bin/supervisor" "$style_control/supervisor" || style_die
style_restore || style_die
exec "$style_control/supervisor" --launch "$style_control" \
    "$style_snapshot/scripts/bootstrap/style_worker" "$style_root" "$style_requested_cache" "$style_tool_path" -- "$@"
style_die
