# Native quality workflow. Python remains the shipping compatibility reference.
fn main() -> Int:
    let argc = System.args_count()
    let flag_error = cli_flags(index: 1, argc: argc)
    if not String.eq(flag_error, ""):
        cli_failure(flag_error)
    else:
        if has_flag(argc, "--help"):
            print_help()
            0
        else:
            let extras = cli_extras(index: 1, argc: argc, options: true, positional: 0, extras: [])
            if not List.is_empty(extras):
                let names = String.join(extras, " ")
                cli_failure("unrecognized arguments: {names}")
            else:
                quality_workflow(argc)

fn cli_failure(error: String) -> Int:
    let usage = "usage: check_style [paths ...] [--lenient] [--style-only] [--pre-commit] [--summary]\n"
    match System.write_stderr("{usage}check_style: error: {error}\n"):
        Ok(()) -> 2
        Err(_) -> 2

fn quality_workflow(argc: Int) -> Int:
    let lenient = has_flag(argc, "--lenient")
    let mode = if lenient: "lenient mode" else: "strict mode"
    let header = Tui.Panel.new("Fern Quality Checker")
    let header = Tui.Panel.subtitle(header, mode)
    println(Tui.Panel.render(header))
    println("")
    let build_ok = run_build_checks(style_only: has_flag(argc, "--style-only"))
    println(Tui.Style.bold("FERN_STYLE Compliance"))
    println("")
    let totals = check_paths(get_paths_to_check(argc), files: 0, errors: 0, warnings: 0)
    let files: Int = totals.0
    let errors: Int = totals.1
    let warnings: Int = totals.2
    print_style_summary(files: files, errors: errors, warnings: warnings, summary: has_flag(argc, "--summary"))
    if has_flag(argc, "--pre-commit"):
        println("\nGit Hygiene\n")
        check_git_hygiene()
    let style_ok = errors == 0 and (lenient or warnings == 0)
    println("")
    if build_ok and style_ok:
        println(Tui.Status.ok("All checks passed!"))
        0
    else:
        println(Tui.Status.error("Checks failed - fix issues before committing"))
        1

fn print_help():
    println("usage: check_style [paths ...] [--lenient] [--style-only] [--pre-commit] [--summary]")
    println("Fern Quality Checker - Build, Test, Examples, and FERN_STYLE")
    println("Directories or files to check (default: src lib)")
    println("-h, --help       Show this help message and exit")
    println("--lenient        Allow warnings (default is strict mode)")
    println("--style-only     Only run FERN_STYLE checks (skip build/test/examples)")
    println("--pre-commit     Pre-commit hook mode (full strict check + git hygiene)")
    println("--summary        Show only summary, not individual violations")
    println("\nModes:")
    println("  Default (strict)    Run all checks, warnings are errors")
    println("  --lenient           Run all checks, allow warnings")
    println("  --style-only        Only FERN_STYLE checks (skip build/test/examples)")
    println("  --pre-commit        Pre-commit hook mode (includes git hygiene)")
    println("\nAll Checks Run:")
    println("  1. Build            mise run clean && mise run debug (no warnings)")
    println("  2. Tests            mise run test (all must pass)")
    println("  3. Examples         Type-check all examples/*.fn files")
    println("  4. FERN_STYLE       Code compliance checks")

fn known_flags() -> List(String):
    ["--help", "--lenient", "--style-only", "--pre-commit", "--summary"]

fn canonical_flag(arg: String) -> String:
    if String.eq(arg, "--diagnostics"):
        arg
    else:
        if String.starts_with(arg, "-h") and not short_help_value(arg):
            "--help"
        else:
            public_flag(arg)

fn short_help_value(arg: String) -> Bool:
    let parts = String.split(arg, "=")
    List.len(parts) > 1 and Regex.is_match(List.head(parts), "^-h+$")

fn public_flag(arg: String) -> String:
    if not String.starts_with(arg, "--") or String.eq(arg, "--"):
        ""
    else:
        flag_prefix(arg: arg, flags: known_flags(), found: "")

fn flag_prefix(arg: String, flags: List(String), found: String) -> String:
    if List.is_empty(flags):
        found
    else:
        let name: String = List.head(flags)
        if String.starts_with(name, arg):
            if not String.eq(found, ""): "ambiguous" else: flag_prefix(arg: arg, flags: List.tail(flags), found: name)
        else:
            flag_prefix(arg: arg, flags: List.tail(flags), found: found)

fn cli_flags(index: Int, argc: Int) -> String:
    if index >= argc:
        ""
    else:
        let arg = System.arg(index)
        if String.eq(arg, "--") or String.eq(canonical_flag(arg), "--help"):
            ""
        else:
            let parts = String.split(arg, "=")
            let flag = canonical_flag(List.head(parts))
            if String.eq(flag, "ambiguous"):
                let names = String.join(matching_flags(List.head(parts), known_flags()), ", ")
                "ambiguous option: {arg} could match {names}"
            else:
                if List.len(parts) > 1 and not String.eq(flag, ""):
                    let value = String.join(List.tail(parts), "=")
                    let display = if String.eq(flag, "--help"): "-h/--help" else: flag
                    "argument {display}: ignored explicit argument '{value}'"
                else:
                    cli_flags(index: index + 1, argc: argc)

fn matching_flags(prefix: String, flags: List(String)) -> List(String):
    if List.is_empty(flags):
        []
    else:
        let rest = matching_flags(prefix, List.tail(flags))
        let name = List.head(flags)
        if String.starts_with(name, prefix): List.concat([name], rest) else: rest

# Python3.14 argparse accepts a decimal scalar prefix after '-' or '-.'.
fn negative_numeric_path(arg: String) -> Bool:
    if not String.starts_with(arg, "-"):
        false
    else:
        let start = if String.starts_with(arg, "-."): 2 else: 1
        let end = prefix_end(arg, count: 1, index: start)
        String.is_decimal(String.slice(arg, start, end))

# argparse's paths operand occupies one contiguous positional argument group.
fn cli_extras(index: Int, argc: Int, options: Bool, positional: Int, extras: List(String)) -> List(String):
    if index >= argc:
        extras
    else:
        let arg = System.arg(index)
        if options and String.eq(arg, "--"):
            cli_extras(index: index + 1, argc: argc, options: false, positional: positional, extras: extras)
        else:
            let option = options and String.starts_with(arg, "-") and not String.eq(arg, "-") and not negative_numeric_path(arg)
            if option:
                let extras = if String.eq(canonical_flag(arg), ""): List.push(extras, arg) else: extras
                let positional = if positional == 1: 2 else: positional
                cli_extras(index: index + 1, argc: argc, options: options, positional: positional, extras: extras)
            else:
                let extras = if positional == 2: List.push(extras, arg) else: extras
                let positional = if positional == 0: 1 else: positional
                cli_extras(index: index + 1, argc: argc, options: options, positional: positional, extras: extras)

fn has_flag(argc: Int, flag: String) -> Bool:
    has_flag_rec(index: 1, argc: argc, flag: flag)

fn has_flag_rec(index: Int, argc: Int, flag: String) -> Bool:
    if index >= argc:
        false
    else:
        let arg = System.arg(index)
        if String.eq(arg, "--"):
            false
        else:
            String.eq(canonical_flag(arg), flag) or has_flag_rec(index: index + 1, argc: argc, flag: flag)

fn get_paths_to_check(argc: Int) -> List(String):
    let paths = collect_paths_rec(index: 1, argc: argc, options: true, paths: [])
    if List.is_empty(paths): ["src", "lib"] else: paths

fn collect_paths_rec(index: Int, argc: Int, options: Bool, paths: List(String)) -> List(String):
    if index >= argc:
        paths
    else:
        let arg = System.arg(index)
        if options and String.eq(arg, "--"):
            collect_paths_rec(index: index + 1, argc: argc, options: false, paths: paths)
        else:
            let paths = if options and not String.eq(canonical_flag(arg), ""):
                paths
            else:
                List.push(paths, arg)
            collect_paths_rec(index: index + 1, argc: argc, options: options, paths: paths)

# Literal process capture never invokes a shell or publishes partial failure output.
fn workflow_command(args: List(String)) -> (Int, String, String):
    match System.exec_args_bounded(args, 300000, 8388608):
        Ok(result) -> result
        Err(code) -> (1, "", process_failure(code))

fn process_failure(code: Int) -> String:
    if code == 3:
        "Command timed out"
    else:
        if code == 4:
            "Command output limit exceeded"
        else:
            "Command failed (process error {code})"

fn check_build() -> (Bool, String, String):
    let clean = workflow_command(["mise", "run", "clean"])
    if clean.0 != 0:
        (false, "Clean failed", "")
    else:
        let build = workflow_command(["mise", "run", "debug"])
        let output: String = build.1 + build.2
        let lower = String.to_lower(output)
        if build.0 != 0:
            (false, "Build failed", output)
        else:
            if String.contains(lower, "warning:") or String.contains(lower, "error:"):
                (false, "Build has warnings/errors", output)
            else:
                (true, "Build clean", "")

fn check_tests() -> (Bool, String, String):
    let result = workflow_command(["mise", "run", "test"])
    let output: String = result.1 + result.2
    if result.0 != 0:
        (false, "Tests failed", output)
    else:
        let matches = Regex.find_all(output, "Passed:[[:space:]]*[0-9]+")
        if List.is_empty(matches):
            (true, "Tests passed", "")
        else:
            let count = Regex.replace_all(List.head(matches), "Passed:[[:space:]]*", "")
            (true, "All tests passing ({count} tests)", "")

fn check_examples() -> (Bool, String, String):
    if not File.exists("examples"):
        (true, "No examples directory", "")
    else:
        if not File.is_dir("examples"):
            (true, "No .fn files in examples/", "")
        else:
            match File.list_dir("examples"):
                Ok(files) -> prepare_examples(example_names(files: files, result: []))
                Err(code) -> (false, "Cannot list examples", "error {code}")

fn example_names(files: List(String), result: List(String)) -> List(String):
    if List.is_empty(files):
        sort_strings(result)
    else:
        let name: String = List.head(files)
        let result = if String.ends_with(name, ".fn"): List.push(result, name) else: result
        example_names(files: List.tail(files), result: result)

fn prepare_examples(files: List(String)) -> (Bool, String, String):
    if List.is_empty(files):
        (true, "No .fn files in examples/", "")
    else:
        if not File.exists("bin/fern"):
            (false, "Fern compiler not built", "Run mise run debug first")
        else:
            check_example_files(files: files, passed: 0, failed: 0, details: [])

fn check_example_files(files: List(String), passed: Int, failed: Int, details: List(String)) -> (Bool, String, String):
    if List.is_empty(files):
        let total = passed + failed
        if failed > 0:
            (false, "{failed}/{total} examples failed type check", String.join(details, "\n"))
        else:
            (true, "All {passed} examples type-check", "")
    else:
        let name: String = List.head(files)
        let result = workflow_command(["bin/fern", "check", "examples/" + name])
        if result.0 == 0:
            check_example_files(files: List.tail(files), passed: passed + 1, failed: failed, details: details)
        else:
            let stderr: String = result.2
            let error: String = if String.eq(stderr, ""): result.1 else: stderr
            let details = if failed < 5:
                List.push(details, "  {name}: {text_prefix(error, 100)}")
            else:
                details
            check_example_files(files: List.tail(files), passed: passed, failed: failed + 1, details: details)

# Native String indices count bytes; only slice at a complete UTF8 scalar boundary.
fn text_prefix(text: String, count: Int) -> String:
    String.slice(text, 0, prefix_end(text, count: count, index: 0))

fn prefix_end(text: String, count: Int, index: Int) -> Int:
    if count == 0 or index >= String.len(text):
        index
    else:
        let byte = Option.unwrap_or(String.char_at(text, index), 0)
        let width = if byte < 128: 1 else: if byte < 224: 2 else: if byte < 240: 3 else: 4
        prefix_end(text, count: count - 1, index: index + width)

fn print_check_result(name: String, result: (Bool, String, String)) -> Bool:
    let success: Bool = result.0
    let message: String = result.1
    if success:
        println(Tui.Status.ok("  {name}: {message}"))
    else:
        println(Tui.Status.error("  {name}: {message}"))
        if not String.eq(result.2, ""):
            println(result.2)
    success

fn check_git_hygiene():
    let available = workflow_command(["git", "rev-parse", "--git-dir"])
    let reminders = if available.0 != 0:
        []
    else:
        let staged = workflow_command(["git", "diff", "--cached", "--name-only", "--diff-filter=ACM"])
        if staged.0 != 0: [] else: git_reminders(String.lines(String.trim(staged.1)))
    if List.is_empty(reminders):
        println(Tui.Status.ok("  No issues detected"))
    else:
        for reminder in reminders:
            println(Tui.Status.warn("  {reminder}"))

fn git_reminders(files: List(String)) -> List(String):
    if not staged_code(files):
        []
    else:
        let messages: List(String) = []
        let messages = if staged_feature(files) and not list_contains_string(files, "ROADMAP.md"):
            List.push(messages, "Reminder: Consider updating ROADMAP.md for feature changes")
        else:
            messages
        if staged_design(files) and not list_contains_string(files, "DECISIONS.md"):
            List.push(messages, "Reminder: Did you make a design decision? Consider /decision")
        else:
            messages

fn staged_code(files: List(String)) -> Bool:
    if List.is_empty(files): false else:
        let name: String = List.head(files)
        String.ends_with(name, ".c") or String.ends_with(name, ".h") or staged_code(List.tail(files))

fn staged_feature(files: List(String)) -> Bool:
    if List.is_empty(files): false else:
        String.contains(String.to_lower(List.head(files)), "feat") or staged_feature(List.tail(files))

fn staged_design(files: List(String)) -> Bool:
    if List.is_empty(files): false else:
        let name: String = List.head(files)
        String.starts_with(name, "include/") or String.eq(name, "DESIGN.md") or staged_design(List.tail(files))

fn print_style_summary(files: Int, errors: Int, warnings: Int, summary: Bool):
    if files == 0:
        println("No .c files found to check")
    else:
        println("Checked {files} files\n")
        if errors + warnings == 0:
            println("All files pass FERN_STYLE checks")
        else:
            if summary:
                println("{errors} errors, {warnings} warnings")
            else:
                println("{errors} errors, {warnings} warnings")

# Check a path (file or directory)
fn check_path(path: String) -> (Int, Int, Int):
    let is_dir = File.is_dir(path)
    let is_c_file = String.ends_with(path, ".c")
    check_path_impl(path, is_dir: is_dir, is_c_file: is_c_file)

# Implementation helper to avoid nested if/else codegen issues
fn check_path_impl(path: String, is_dir: Bool, is_c_file: Bool) -> (Int, Int, Int):
    if is_dir:
        check_directory(path)
    else:
        check_single_file(path, is_c_file: is_c_file)

# Check a single file (not a directory)
fn check_single_file(path: String, is_c_file: Bool) -> (Int, Int, Int):
    if is_c_file and File.exists(path):
        let v = check_file(path)
        (1, v.0, v.1)
    else:
        (0, 0, 0)

# Check all .c files in a directory
fn check_directory(dir: String) -> (Int, Int, Int):
    match File.list_dir(dir):
        Ok(entries) -> check_entries(dir, entries, files: 0, errors: 0, warnings: 0)
        Err(code) ->
            println("Cannot list {dir}: error {code}")
            (0, 1, 0)

# Walk directory entries once, preserving immutable error and warning counts.
fn check_entries(dir: String, entries: List(String), files: Int, errors: Int, warnings: Int) -> (Int, Int, Int):
    if List.is_empty(entries):
        (files, errors, warnings)
    else:
        let path = dir + "/" + List.head(entries)
        let result = check_path(path)
        check_entries(dir, List.tail(entries), files: files + result.0, errors: errors + result.1, warnings: warnings + result.2)

# Check a single C file for FERN_STYLE violations
fn check_file(filepath: String) -> (Int, Int):
    let content_result = File.read(filepath)

    match content_result:
        Ok(content) -> check_file_content(filepath: filepath, content: content)
        Err(_) -> check_file_error(filepath)

# Handle file read error
fn check_file_error(filepath: String) -> (Int, Int):
    println(Tui.Status.error("Could not read: {filepath}"))
    (1, 0)

# Check file with valid content
fn check_file_content(filepath: String, content: String) -> (Int, Int):
    let lines = String.split(content, "\n")
    let violations: List((String, Int, String, String, String)) = []

    # Check for manual tagged unions at file level
    let violations = check_tagged_unions(filepath: filepath, content: content, violations: violations)

    # Find all functions and check them
    let functions = find_functions(lines)

    let violations = check_functions(filepath, functions, violations)

    let argc = System.args_count()
    let lenient = has_flag(argc, "--lenient")
    let diagnostics = has_flag(argc, "--diagnostics")
    let summary = has_flag(argc, "--summary")
    if diagnostics:
        print_diagnostics(violations, lenient: lenient)
        ()
    else:
        if not summary and List.len(violations) > 0:
            println("")
            println(Tui.Style.bold(filepath))
            print_violations_table(violations)
    let errors = count_severity(violations, lenient: lenient, severity: "error", total: 0)
    (errors, List.len(violations) - errors)

# Classify warnings exactly as the compatibility reference does.
fn violation_severity(rule: String, lenient: Bool) -> String:
    let warning = String.eq(rule, "no-tagged-union") or (lenient and
        (String.eq(rule, "bounded-loops") or String.eq(rule, "doc-comment") or
        String.eq(rule, "doc-params") or String.eq(rule, "doc-return") or
        String.eq(rule, "no-raw-char")))
    if warning: "warning" else: "error"

# Emit stable fields for regression comparison without depending on table rendering.
fn print_diagnostics(violations: List((String, Int, String, String, String)), lenient: Bool) -> ():
    for v in violations:
        let file: String = v.0
        let line: Int = v.1
        let name: String = v.2
        let rule: String = v.3
        let message: String = v.4
        let severity = violation_severity(rule, lenient: lenient)
        println("DIAG\t{file}\t{line}\t{name}\t{rule}\t{message}\t{severity}")

# Collect single-line enum discriminator diagnostics with explicit immutable state.
fn check_tagged_unions(filepath: String, content: String, violations: List((String, Int, String, String, String))) -> List((String, Int, String, String, String)):
    if String.contains(content, "FERN_STYLE: allow(no-tagged-union)"):
        violations
    else:
        check_tagged_lines(filepath, String.lines(content), 1, violations)

# Scan enum discriminator lines with explicit line numbers and diagnostics.
fn check_tagged_lines(filepath: String, lines: List(String), line_number: Int, violations: List((String, Int, String, String, String))) -> List((String, Int, String, String, String)):
    if List.is_empty(lines):
        violations
    else:
        let line: String = List.head(lines)
        let violations = if Regex.is_match(line, "(^|[^a-zA-Z0-9_])enum[[:space:]]*[\{][^\}]+[\}][[:space:]]*(kind|tag|type)[[:space:]]*;"):
            let v = make_violation(file: filepath, line: line_number, name: "", rule: "no-tagged-union", msg: "Manual tagged union detected - use Datatype99 instead")
            List.push(violations, v)
        else:
            violations
        check_tagged_lines(filepath, List.tail(lines), line_number + 1, violations)

# Check one function using its parsed body, signature and documentation facts.
fn check_function(filepath: String, func: (String, Int, Int, Int, String, Bool, List(String), String, List(String)), violations: List((String, Int, String, String, String))) -> List((String, Int, String, String, String)):
    let violations = violations
    let func_name: String = func.0
    let start_line: Int = func.1
    let end_line: Int = func.2
    let assertions: Int = func.3
    let body: String = func.4
    let has_doc: Bool = func.5
    let param_names: List(String) = func.6
    let return_type: String = func.7
    let doc_params: List(String) = func.8

    let violations = add_rule_violation(filepath: filepath, line: start_line, name: func_name, body: body, violations: violations, failed: assertions < 2, rule: "assertion-density", message: "{assertions} assertions (need 2+)")
    let length = end_line - start_line
    let violations = add_rule_violation(filepath: filepath, line: start_line, name: func_name, body: body, violations: violations, failed: length > 70, rule: "function-length", message: "{length} lines (max 70)")
    let violations = add_rule_violation(filepath: filepath, line: start_line, name: func_name, body: body, violations: violations, failed: has_call(body: function_body(body), name: "malloc"), rule: "no-malloc", message: "Uses malloc() - use arena allocation instead")
    let violations = add_rule_violation(filepath: filepath, line: start_line, name: func_name, body: body, violations: violations, failed: has_call(body: function_body(body), name: "free"), rule: "no-free", message: "Uses free() - use arena allocation instead")
    let violations = add_rule_violation(filepath: filepath, line: start_line, name: func_name, body: body, violations: violations, failed: has_unbounded_loop(body), rule: "bounded-loops", message: "Unbounded loop detected - add explicit limit")
    let violations = add_rule_violation(filepath: filepath, line: start_line, name: func_name, body: body, violations: violations, failed: has_raw_char_param(body), rule: "no-raw-char", message: "Raw char* parameter - use sds or const char* instead")

    # Check for doc comment
    let violations = check_doc_comment_violations(filepath: filepath, line: start_line, func_name: func_name, body: body, has_doc: has_doc, param_names: param_names, return_type: return_type, doc_params: doc_params, violations: violations)

    violations

# Check doc comment related violations
fn check_doc_comment_violations(filepath: String, line: Int, func_name: String, body: String, has_doc: Bool, param_names: List(String), return_type: String, doc_params: List(String), violations: List((String, Int, String, String, String))) -> List((String, Int, String, String, String)):
    if not has_doc:
        if not has_allow(body: body, rule: "doc-comment"):
            let v = make_violation(file: filepath, line: line, name: func_name,
                rule: "doc-comment", msg: "Missing doc comment (add /** ... */ before function)")
            List.push(violations, v)
        else:
            violations
    else:
        # Check for missing @param documentation
        let violations = check_doc_params(filepath: filepath, line: line, func_name: func_name, body: body, param_names: param_names, doc_params: doc_params, violations: violations)
        # Check for missing @return documentation
        check_doc_return(filepath: filepath, line: line, func_name: func_name, body: body, return_type: return_type, violations: violations)

# Check that all function parameters are documented with @param
fn check_doc_params(filepath: String, line: Int, func_name: String, body: String, param_names: List(String), doc_params: List(String), violations: List((String, Int, String, String, String))) -> List((String, Int, String, String, String)):
    if has_allow(body: body, rule: "doc-params") or has_allow(body: body, rule: "doc-style"):
        violations
    else:
        check_doc_params_rec(filepath: filepath, line: line, func_name: func_name, param_names: param_names, doc_params: doc_params, violations: violations)

fn check_doc_params_rec(filepath: String, line: Int, func_name: String, param_names: List(String), doc_params: List(String), violations: List((String, Int, String, String, String))) -> List((String, Int, String, String, String)):
    let missing = missing_parameters(names: param_names, documented: doc_params, missing: [])
    if List.is_empty(missing):
        violations
    else:
        let missing = sort_strings(missing)
        let names = String.join(missing, ", ")
        let v = make_violation(file: filepath, line: line, name: func_name, rule: "doc-params", msg: "Missing @param for: {names}")
        List.push(violations, v)

# Insert-sort small parameter lists using deterministic lexical ordering.
fn sort_strings(values: List(String)) -> List(String):
    if List.is_empty(values):
        values
    else:
        insert_string(List.head(values), sort_strings(List.tail(values)))

fn insert_string(value: String, values: List(String)) -> List(String):
    if List.is_empty(values):
        [value]
    else:
        let first: String = List.head(values)
        if string_before(a: value, b: first, index: 0):
            List.concat([value], values)
        else:
            List.concat([first], insert_string(value, List.tail(values)))

# Compare parameter identifiers by code point with a bounded character scan.
fn string_before(a: String, b: String, index: Int) -> Bool:
    if index >= String.len(a):
        true
    else:
        if index >= String.len(b):
            false
        else:
            let left = match String.char_at(a, index):
                Some(c) -> c
                None -> 0
            let right = match String.char_at(b, index):
                Some(c) -> c
                None -> 0
            if left == right:
                string_before(a: a, b: b, index: index + 1)
            else:
                left < right

# Check that non-void functions have @return documentation
fn check_doc_return(filepath: String, line: Int, func_name: String, body: String, return_type: String, violations: List((String, Int, String, String, String))) -> List((String, Int, String, String, String)):
    if has_allow(body: body, rule: "doc-return") or has_allow(body: body, rule: "doc-style"):
        violations
    else:
        # Check if return type is void (may be "void", "static void", etc.)
        let is_void = String.ends_with(return_type, "void") or String.eq(return_type, "")
        if is_void:
            violations
        else:
            # Only the sentinel appended from the parsed API comment grants return docs.
            if String.ends_with(body, "\n@return"):
                violations
            else:
                let v = make_violation(file: filepath, line: line, name: func_name,
                    rule: "doc-return", msg: "Missing @return for non-void function")
                List.push(violations, v)

# Check if a string is in a list of strings
fn list_contains_string(list: List(String), s: String) -> Bool:
    if List.is_empty(list):
        false
    else:
        let head: String = List.head(list)
        if String.eq(head, s):
            true
        else:
            list_contains_string(List.tail(list), s)

# Check for unbounded loops: while(1), while(true), for(;;)
# Search loop conditions without mutable local state.
fn has_unbounded_loop(body: String) -> Bool:
    let body = function_body(body)
    let found = Regex.is_match(body, "(^|[^a-zA-Z0-9_])for[[:space:]]*[(][[:space:]]*;[[:space:]]*;[[:space:]]*[)]")
    found or has_unbounded_while(Regex.find_all(body, "(^|[^a-zA-Z0-9_])while[[:space:]]*[(][^)]+[)]"))

# Test each while condition until an unbounded one is found.
fn has_unbounded_while(loops: List(String)) -> Bool:
    if List.is_empty(loops):
        false
    else:
        let loop: String = List.head(loops)
        let condition = Regex.replace(loop, "^[^(]*[(]", "")
        let condition = String.trim(condition)
        let condition = String.trim(Regex.replace_all(condition, "[)]$", ""))
        let unbounded = not Regex.is_match(condition, "[<>=!]") and not String.eq(condition, "0") and not String.eq(condition, "false")
        unbounded or has_unbounded_while(List.tail(loops))

fn has_raw_char_param(body: String) -> Bool:
    let signature: String = List.head(String.lines(body))
    let parts = String.split(signature, "(")
    if List.len(parts) < 2:
        false
    else:
        let params: String = List.head(String.split(List.get(parts, 1), ")"))
        let without_const = Regex.replace_all(params, "const[[:space:]]char", "CONST_CHAR")
        (not String.contains(params, "argv") and not String.contains(params, "argc") and
            Regex.is_match(without_const, "char[[:space:]]*[*]"))

# Exclude the signature from body-only rules, matching the Python scan.
fn function_body(body: String) -> String:
    String.join(List.tail(String.lines(body)), "\n")

# Recognize C call tokens, allowing whitespace without matching name suffixes.
fn has_call(body: String, name: String) -> Bool:
    Regex.is_match(body, "(^|[^a-zA-Z0-9_])" + name + "[[:space:]]*[(]")

# Create a violation record
fn make_violation(file: String, line: Int, name: String, rule: String, msg: String) -> (String, Int, String, String, String):
    (file, line, name, rule, msg)

# Print violations as a table
fn print_violations_table(violations: List((String, Int, String, String, String))):
    let table = Tui.Table.new()
    let table = Tui.Table.add_column(table, "")
    let table = Tui.Table.add_column(table, "Function")
    let table = Tui.Table.add_column(table, "Line")
    let table = Tui.Table.add_column(table, "Rule")
    let table = Tui.Table.add_column(table, "Message")
    let table = Tui.Table.show_header(table, 0)
    let table = Tui.Table.border(table, "simple")

    for v in violations:
        # Extract tuple fields with type annotations to ensure correct codegen
        let v_name: String = v.2
        let v_line: Int = v.1
        let v_rule: String = v.3
        let lenient = has_flag(System.args_count(), "--lenient")
        let warning = String.eq(violation_severity(v_rule, lenient: lenient), "warning")
        let icon = if warning: Tui.Style.yellow("!") else: Tui.Style.red("X")
        let v_msg: String = v.4
        let label = if String.eq(v_name, ""): "file" else: v_name + "()"
        let func_name = Tui.Style.yellow(label)
        let line_str: String = "" + "{v_line}"
        let rule: String = Tui.Style.magenta(v_rule)
        let msg: String = v_msg

        let row = [icon, func_name, line_str, rule, msg]
        let table = Tui.Table.add_row(table, row)

    println(Tui.Table.render(table))

# Check if body contains FERN_STYLE: allow(rule)
# Match explicit rule exemptions, preserving exact compatibility spelling.
fn has_allow(body: String, rule: String) -> Bool:
    has_allow_lines(String.lines(body), rule)

# Find the first matching explicit exemption across source lines.
fn has_allow_lines(lines: List(String), rule: String) -> Bool:
    if List.is_empty(lines):
        false
    else:
        let matches = Regex.find_all(List.head(lines), "(//|/[*])[[:space:]]*FERN_STYLE:[[:space:]]*allow[(][^)]+[)]")
        let allowed = if List.is_empty(matches):
            false
        else:
            let text: String = List.head(matches)
            let start: String = List.get(String.split(text, "allow("), 1)
            let rules: String = List.head(String.split(start, ")"))
            has_allow_items(String.split(rules, ","), rule)
        allowed or has_allow_lines(List.tail(lines), rule)

# Compare comma-separated exemption names after trimming.
fn has_allow_items(items: List(String), rule: String) -> Bool:
    if List.is_empty(items):
        false
    else:
        String.eq(String.trim(List.head(items)), rule) or has_allow_items(List.tail(items), rule)

fn find_functions(lines: List(String)) -> List((String, Int, Int, Int, String, Bool, List(String), String, List(String))):
    let functions: List((String, Int, Int, Int, String, Bool, List(String), String, List(String))) = []
    find_functions_rec(lines, 0, functions)

# Advance directly to the end of each function, including unmatched braces.
fn find_functions_rec(lines: List(String), i: Int, functions: List((String, Int, Int, Int, String, Bool, List(String), String, List(String)))) -> List((String, Int, Int, Int, String, Bool, List(String), String, List(String))):
    if i >= List.len(lines):
        functions
    else:
        let line: String = List.get(lines, i)
        if is_function_start(line):
            let trimmed = String.trim(line)
            let func_name = extract_function_name(trimmed)
            let start_line = i + 1
            let doc_result = parse_doc_comment(lines, i)
            let has_doc: Bool = doc_result.0
            let doc_params: List(String) = doc_result.1
            let has_return_doc: Bool = doc_result.2
            let param_names = extract_param_names(trimmed)
            let return_type = extract_return_type(trimmed)
            let result = find_function_end(lines, i)
            let end_line: Int = result.0
            let body: String = result.1
            let body = if has_return_doc: body + "\n@return" else: body
            let assertions = count_assertions(body)
            let func = (func_name, start_line, end_line, assertions, body, has_doc, param_names, return_type, doc_params)
            find_functions_rec(lines, end_line, List.push(functions, func))
        else:
            find_functions_rec(lines, i + 1, functions)

# Parse documentation comment before a function
# Returns (has_doc, documented_params, has_return)
fn parse_doc_comment(lines: List(String), func_line_idx: Int) -> (Bool, List(String), Bool):
    let search_start = if func_line_idx > 30: func_line_idx - 30 else: 0
    parse_doc_comment_rec(lines, idx: func_line_idx - 1, search_start: search_start)

fn parse_doc_comment_rec(lines: List(String), idx: Int, search_start: Int) -> (Bool, List(String), Bool):
    let empty_params: List(String) = []
    if idx < search_start:
        (false, empty_params, false)
    else:
        let line: String = List.get(lines, idx)
        let trimmed = String.trim(line)

        # Check for end of block comment
        if String.ends_with(trimmed, "*/"):
            # Found potential doc comment, search backwards for start
            find_block_comment_start(lines, end_idx: idx, search_start: search_start)
        else:
            # Check for /// style comments
            if String.starts_with(trimmed, "///"):
                collect_triple_slash_comment(lines, start_idx: idx, search_start: search_start)
            else:
                # Check for empty line or other content
                if String.len(trimmed) == 0:
                    parse_doc_comment_rec(lines, idx: idx - 1, search_start: search_start)
                else:
                    # Non-comment content before function
                    if String.starts_with(trimmed, "//"):
                        parse_doc_comment_rec(lines, idx: idx - 1, search_start: search_start)
                    else:
                        (false, empty_params, false)

# Find the start of a block comment and extract @param/@return
fn find_block_comment_start(lines: List(String), end_idx: Int, search_start: Int) -> (Bool, List(String), Bool):
    let empty_params: List(String) = []
    find_block_comment_start_rec(lines: lines, current_idx: end_idx, end_idx: end_idx, search_start: search_start, params: empty_params, has_return: false)

fn find_block_comment_start_rec(lines: List(String), current_idx: Int, end_idx: Int, search_start: Int, params: List(String), has_return: Bool) -> (Bool, List(String), Bool):
    let empty_params: List(String) = []
    if current_idx < search_start:
        (false, empty_params, false)
    else:
        let line: String = List.get(lines, current_idx)
        let trimmed = String.trim(line)

        # Extract @param names from this line
        let params = if String.contains(line, "@param"):
            extract_param_from_doc_line(line, params)
        else:
            params

        # Check for @return
        let has_return = has_return or Regex.is_match(line, "@returns?([^a-zA-Z0-9_]|$)")

        # Check for start of block comment
        if String.starts_with(trimmed, "/**") or String.starts_with(trimmed, "/*"):
            # Found the start - check if it has description
            let has_desc = has_doc_description(lines, start_idx: current_idx, end_idx: end_idx)
            (has_desc, params, has_return)
        else:
            find_block_comment_start_rec(lines: lines, current_idx: current_idx - 1, end_idx: end_idx, search_start: search_start, params: params, has_return: has_return)

# Check if doc comment has a description (not just @tags)
fn has_doc_description(lines: List(String), start_idx: Int, end_idx: Int) -> Bool:
    has_doc_description_rec(lines, idx: start_idx, end_idx: end_idx)

fn has_doc_description_rec(lines: List(String), idx: Int, end_idx: Int) -> Bool:
    if idx > end_idx:
        false
    else:
        let line: String = List.get(lines, idx)
        # Strip comment markers and check for non-tag content
        let content = String.trim(line)
        let content = strip_comment_markers(content)
        let content = String.trim(content)

        # Skip empty lines and lines starting with @
        if String.len(content) == 0:
            has_doc_description_rec(lines, idx: idx + 1, end_idx: end_idx)
        else:
            if String.starts_with(content, "@"):
                has_doc_description_rec(lines, idx: idx + 1, end_idx: end_idx)
            else:
                # Found description text
                true

# Strip /** /* */ * // markers from a line
fn strip_comment_markers(line: String) -> String:
    let line = if String.starts_with(line, "/**"): String.slice(line, 3, String.len(line)) else: line
    let line = if String.starts_with(line, "/*"): String.slice(line, 2, String.len(line)) else: line
    let line = if String.ends_with(line, "*/"): String.slice(line, 0, String.len(line) - 2) else: line
    let line = if String.starts_with(line, "*"): String.slice(line, 1, String.len(line)) else: line
    let line = if String.starts_with(line, "///"): String.slice(line, 3, String.len(line)) else: line
    let line = if String.starts_with(line, "//"): String.slice(line, 2, String.len(line)) else: line
    line

# Extract @param name from a doc comment line
# Return all documented parameter names in source order.
fn extract_param_from_doc_line(line: String, params: List(String)) -> List(String):
    append_doc_parameters(matches: Regex.find_all(line, "@param[[:space:]]+([a-zA-Z0-9_]+|[.][.][.])"), params: params)

# Append extracted parameter names while retaining source order.
fn append_doc_parameters(matches: List(String), params: List(String)) -> List(String):
    if List.is_empty(matches):
        params
    else:
        let name = Regex.replace(List.head(matches), "^@param[[:space:]]+", "")
        append_doc_parameters(matches: List.tail(matches), params: List.push(params, name))

fn collect_triple_slash_comment(lines: List(String), start_idx: Int, search_start: Int) -> (Bool, List(String), Bool):
    let empty_params: List(String) = []
    collect_triple_slash_rec(lines: lines, idx: start_idx, search_start: search_start, params: empty_params, has_return: false, has_desc: false)

fn collect_triple_slash_rec(lines: List(String), idx: Int, search_start: Int, params: List(String), has_return: Bool, has_desc: Bool) -> (Bool, List(String), Bool):
    if idx < search_start:
        (has_desc, params, has_return)
    else:
        let line: String = List.get(lines, idx)
        let trimmed = String.trim(line)

        if String.starts_with(trimmed, "///"):
            # Extract @param if present
            let params = if String.contains(line, "@param"):
                extract_param_from_doc_line(line, params)
            else:
                params

            # Check for @return
            let has_return = has_return or Regex.is_match(line, "@returns?([^a-zA-Z0-9_]|$)")

            # Check for description (non-empty, non-@ content)
            let content = String.slice(trimmed, 3, String.len(trimmed))
            let content = String.trim(content)
            let has_desc = has_desc or (String.len(content) > 0 and not String.starts_with(content, "@"))

            collect_triple_slash_rec(lines: lines, idx: idx - 1, search_start: search_start, params: params, has_return: has_return, has_desc: has_desc)
        else:
            if String.len(trimmed) == 0:
                collect_triple_slash_rec(lines: lines, idx: idx - 1, search_start: search_start, params: params, has_return: has_return, has_desc: has_desc)
            else:
                (has_desc, params, has_return)

# Extract parameter names from function signature
fn extract_param_names(sig: String) -> List(String):
    let empty: List(String) = []
    # Find the part between parentheses
    let parts = String.split(sig, "(")
    if List.len(parts) < 2:
        empty
    else:
        let after_paren: String = List.get(parts, 1)
        let parts2 = String.split(after_paren, ")")
        if List.is_empty(parts2):
            empty
        else:
            let params_str: String = List.head(parts2)
            let params_str = String.trim(params_str)
            if String.eq(params_str, "") or String.eq(params_str, "void"):
                empty
            else:
                # Split by comma and extract last word from each
                let param_parts = String.split(params_str, ",")
                extract_param_names_from_parts(parts: param_parts, result: empty)

fn extract_param_names_from_parts(parts: List(String), result: List(String)) -> List(String):
    if List.is_empty(parts):
        result
    else:
        let part: String = List.head(parts)
        let rest = List.tail(parts)
        let part = String.trim(Regex.replace_all(part, "[[][^]]*[]]", ""))
        # Handle ... for varargs
        if String.contains(part, "..."):
            let result = List.push(result, "...")
            extract_param_names_from_parts(parts: rest, result: result)
        else:
            # Get last word (possibly with *)
            let words = Regex.split(part, "[[:space:]]+")
            let last_word = get_last_word(words)
            # Remove leading *
            let name = Regex.replace(last_word, "^[*]+", "")
            if String.eq(name, "") or String.eq(name, "void"):
                extract_param_names_from_parts(parts: rest, result: result)
            else:
                let result = List.push(result, name)
                extract_param_names_from_parts(parts: rest, result: result)

fn get_last_word(words: List(String)) -> String:
    if List.is_empty(words):
        ""
    else:
        let head: String = List.head(words)
        let tail = List.tail(words)
        if List.is_empty(tail):
            head
        else:
            get_last_word(tail)

# Extract return type from function signature
fn extract_return_type(sig: String) -> String:
    let empty: List(String) = []
    # Everything before the function name (last word before '(')
    let parts = String.split(sig, "(")
    if List.is_empty(parts):
        ""
    else:
        let before_paren: String = List.head(parts)
        let before_paren = String.trim(before_paren)
        let words = String.split(before_paren, " ")
        # All words except the last one form the return type
        extract_return_type_from_words(words: words, result: empty)

fn extract_return_type_from_words(words: List(String), result: List(String)) -> String:
    if List.is_empty(words):
        ""
    else:
        let tail = List.tail(words)
        if List.is_empty(tail):
            # Last word is the function name, join the accumulated result
            String.join(result, " ")
        else:
            let head: String = List.head(words)
            let result = List.push(result, head)
            extract_return_type_from_words(words: tail, result: result)

# Check if line looks like a function definition start
fn is_function_start(line: String) -> Bool:
    Regex.is_match(line, "^([a-zA-Z0-9_*]+[[:space:]]+)+[a-zA-Z0-9_]+[[:space:]]*[(][^)]*[)][[:space:]]*[\{]")

# Extract function name from definition line
fn extract_function_name(line: String) -> String:
    # Find the part before '('
    let parts = String.split(line, "(")
    if List.len(parts) == 0:
        "unknown"
    else:
        extract_name_from_parts(parts)

# Helper to extract name from parts (avoids early return)
fn extract_name_from_parts(parts: List(String)) -> String:
    let before_paren: String = List.get(parts, 0)
    let words = String.split(String.trim(before_paren), " ")

    # Last word is the function name (possibly with *)
    let last_idx = List.len(words) - 1
    if last_idx < 0:
        "unknown"
    else:
        let name: String = List.get(words, last_idx)
        # Remove leading * if present
        if String.starts_with(name, "*"):
            String.slice(name, 1, String.len(name))
        else:
            name

# Find the end of a function and return (end_line, body_text)
fn find_function_end(lines: List(String), start_idx: Int) -> (Int, String):
    let line_count = List.len(lines)
    let empty_lines: List(String) = []
    find_function_end_rec(lines: lines, idx: start_idx, line_count: line_count, brace_count: 0, body_lines: empty_lines, found_first: false)

# Recursive helper to find function end (avoids return in for loop)
fn find_function_end_rec(lines: List(String), idx: Int, line_count: Int, brace_count: Int, body_lines: List(String), found_first: Bool) -> (Int, String):
    if idx >= line_count:
        # Reached end without finding closing brace
        let body = String.join(body_lines, "\n")
        (line_count, body)
    else:
        let line: String = List.get(lines, idx)
        let body_lines = List.push(body_lines, line)

        # Count braces, ignoring those inside string literals
        let brace_counts = count_braces_outside_strings(line)
        let open_braces: Int = brace_counts.0
        let close_braces: Int = brace_counts.1
        let brace_count = brace_count + open_braces - close_braces

        let found_first = found_first or brace_count > 0

        if found_first and brace_count == 0:
            let body = String.join(body_lines, "\n")
            (idx + 1, body)
        else:
            find_function_end_rec(lines: lines, idx: idx + 1, line_count: line_count, brace_count: brace_count, body_lines: body_lines, found_first: found_first)

# Count braces in a line, ignoring those inside string literals
# Returns (open_braces, close_braces)
fn count_braces_outside_strings(line: String) -> (Int, Int):
    count_braces_rec(line, idx: 0, len: String.len(line), in_string: false, string_char: 0, opens: 0, closes: 0)

fn count_braces_rec(line: String, idx: Int, len: Int, in_string: Bool, string_char: Int, opens: Int, closes: Int) -> (Int, Int):
    if idx >= len:
        (opens, closes)
    else:
        let char_opt = String.char_at(line, idx)
        match char_opt:
            None -> (opens, closes)
            Some(c) -> count_brace_char(line, idx: idx, len: len, in_string: in_string, string_char: string_char, opens: opens, closes: closes, c: c)

fn count_brace_char(line: String, idx: Int, len: Int, in_string: Bool, string_char: Int, opens: Int, closes: Int, c: Int) -> (Int, Int):
    if not in_string:
        # Check for start of string
        if c == 34 or c == 39:  # " or '
            count_braces_rec(line, idx: idx + 1, len: len, in_string: true, string_char: c, opens: opens, closes: closes)
        else:
            if c == 123:  # {
                count_braces_rec(line, idx: idx + 1, len: len, in_string: false, string_char: 0, opens: opens + 1, closes: closes)
            else:
                if c == 125:  # }
                    count_braces_rec(line, idx: idx + 1, len: len, in_string: false, string_char: 0, opens: opens, closes: closes + 1)
                else:
                    count_braces_rec(line, idx: idx + 1, len: len, in_string: false, string_char: 0, opens: opens, closes: closes)
    else:
        # Inside string
        if c == 92:  # backslash - skip next char too
            count_braces_rec(line, idx: idx + 2, len: len, in_string: true, string_char: string_char, opens: opens, closes: closes)
        else:
            if c == string_char:
                # End of string
                count_braces_rec(line, idx: idx + 1, len: len, in_string: false, string_char: 0, opens: opens, closes: closes)
            else:
                # Inside string - ignore
                count_braces_rec(line, idx: idx + 1, len: len, in_string: true, string_char: string_char, opens: opens, closes: closes)

# Count assert() calls in function body
# Count assertions by returning the next accumulator at each recursive step.
fn count_assertions(body: String) -> Int:
    count_assertion_lines(String.lines(function_body(body)), 0)

# Count at most one assertion-bearing call line per step.
fn count_assertion_lines(lines: List(String), count: Int) -> Int:
    if List.is_empty(lines):
        count
    else:
        let count = if has_call(body: List.head(lines), name: "assert"): count + 1 else: count
        count_assertion_lines(List.tail(lines), count)

# Sum path results without rebinding a value inside a loop scope.
fn check_paths(paths: List(String), files: Int, errors: Int, warnings: Int) -> (Int, Int, Int):
    if List.is_empty(paths):
        (files, errors, warnings)
    else:
        let result = check_path(List.head(paths))
        check_paths(List.tail(paths), files: files + result.0, errors: errors + result.1, warnings: warnings + result.2)

# Accumulate each function's ordered diagnostics.
fn check_functions(filepath: String, functions: List((String, Int, Int, Int, String, Bool, List(String), String, List(String))), violations: List((String, Int, String, String, String))) -> List((String, Int, String, String, String)):
    if List.is_empty(functions):
        violations
    else:
        let violations = check_function(filepath, List.head(functions), violations)
        check_functions(filepath, List.tail(functions), violations)

# Preserve strict/lenient failure classification independently of rendering.
fn count_severity(violations: List((String, Int, String, String, String)), lenient: Bool, severity: String, total: Int) -> Int:
    if List.is_empty(violations):
        total
    else:
        let value = List.head(violations)
        let rule: String = value.3
        let total = if String.eq(violation_severity(rule, lenient: lenient), severity): total + 1 else: total
        count_severity(List.tail(violations), lenient: lenient, severity: severity, total: total)

# Collect distinct undocumented parameters in declaration order before sorting.
fn missing_parameters(names: List(String), documented: List(String), missing: List(String)) -> List(String):
    if List.is_empty(names):
        missing
    else:
        let param: String = List.head(names)
        let missing = if not list_contains_string(documented, param) and not list_contains_string(missing, param):
            List.push(missing, param)
        else:
            missing
        missing_parameters(names: List.tail(names), documented: documented, missing: missing)

# Run every build/test check even after an earlier failure.
fn run_build_checks(style_only: Bool) -> Bool:
    if not style_only:
        println(Tui.Style.bold("Build & Test"))
        println("")

        let build_result = check_build()
        let build_ok = print_check_result("Build", build_result)

        let test_result = check_tests()
        let tests_ok = print_check_result("Tests", test_result)

        let examples_result = check_examples()
        let examples_ok = print_check_result("Examples", examples_result)

        println("")
        build_ok and tests_ok and examples_ok
    else:
        true


# Return a new diagnostic list only when a rule fails without a local exemption.
fn add_rule_violation(filepath: String, line: Int, name: String, body: String, violations: List((String, Int, String, String, String)), failed: Bool, rule: String, message: String) -> List((String, Int, String, String, String)):
    if failed and not has_allow(body: body, rule: rule):
        List.push(violations, make_violation(file: filepath, line: line, name: name, rule: rule, msg: message))
    else:
        violations
