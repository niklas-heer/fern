#!/bin/bash
# Authored native build configuration shared by mise and the cached C bootstrap.
set -euo pipefail
case "${1-}" in
    cc) printf '%s\n' clang ;;
    base_cflags) printf '%s\n' '-std=c11 -Wall -Wextra -Wpedantic -Werror -Iinclude -Ilib -Ideps/qbe -Ideps/linenoise' ;;
    debug_flags) printf '%s\n' '-g -O0 -DDEBUG' ;;
    release_flags) printf '%s\n' '-O2 -DNDEBUG' ;;
    qbe_cflags) printf '%s\n' '-std=c99 -Ideps/qbe -Wno-unused-parameter -Wno-sign-compare' ;;
    linenoise_cflags) printf '%s\n' '-std=c11 -Ideps/linenoise -Wno-unused-parameter -Wno-missing-field-initializers' ;;
    civetweb_cflags) printf '%s\n' '-std=c11 -Ideps/civetweb/include -Ideps/civetweb/src -DNO_CGI -DNO_SSL_DL -DOPENSSL_API_1_1' ;;
    runtime_sources) printf '%s\n' 'runtime/*.c' ;;
    src_sources) printf '%s\n' 'src/*.c' ;;
    lib_sources) printf '%s\n' 'lib/*.c' ;;
    test_sources) printf '%s\n' 'tests/*.c' ;;
    qbe_sources) printf '%s\n' 'deps/qbe/main.c deps/qbe/util.c deps/qbe/parse.c deps/qbe/abi.c deps/qbe/cfg.c deps/qbe/mem.c deps/qbe/ssa.c deps/qbe/alias.c deps/qbe/load.c deps/qbe/copy.c deps/qbe/fold.c deps/qbe/simpl.c deps/qbe/live.c deps/qbe/spill.c deps/qbe/rega.c deps/qbe/emit.c deps/qbe/amd64/targ.c deps/qbe/amd64/sysv.c deps/qbe/amd64/isel.c deps/qbe/amd64/emit.c deps/qbe/arm64/targ.c deps/qbe/arm64/abi.c deps/qbe/arm64/isel.c deps/qbe/arm64/emit.c deps/qbe/rv64/targ.c deps/qbe/rv64/abi.c deps/qbe/rv64/isel.c deps/qbe/rv64/emit.c' ;;
    "")
        for name in cc base_cflags debug_flags release_flags qbe_cflags linenoise_cflags civetweb_cflags runtime_sources src_sources lib_sources test_sources qbe_sources; do
            printf '%s=' "$name"
            /bin/bash "$0" "$name"
        done
        ;;
    *) printf 'unknown build configuration: %s\n' "$1" >&2; exit 2 ;;
esac
