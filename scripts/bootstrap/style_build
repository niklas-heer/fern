#!/bin/bash
# Private C-bootstrap build. All command arguments are arrays; metadata is never evaluated.
set -euo pipefail
export LC_ALL=C
: "${FERN_STYLE_CC:?}" "${FERN_STYLE_PKG_CONFIG:?}"
: "${FERN_STYLE_AR:?}" "${FERN_STYLE_METADATA:?}"
[[ $# == 1 ]] || exit 125
cd -P -- "$1"
root=$PWD
source "$root/scripts/bootstrap/style_flags.sh"
mkdir -p build bin
words=()

# Decode one bounded flags record into the global words array; commit only after success.
read_words() {
    local path=$1 word
    "$FERN_STYLE_METADATA" flags < "$path" > build/words.tmp
    words=()
    while IFS= read -r -d '' word; do words+=("$word"); done < build/words.tmp
}

# Obtain effective authored native build variables while retaining the exact evaluated bytes.
configuration() {
    local name=$1
    /bin/bash "$root/scripts/build_config" "$name" > "build/config.$name"
    read_words "build/config.$name"
}

# Decode pkg-config output without shell expansion, preserving quoted or escaped spaces.
pkg_flags() {
    local name=$1 option=$2
    "$FERN_STYLE_PKG_CONFIG" "$option" "$name" > "build/pkg.$name.$option"
    read_words "build/pkg.$name.$option"
    style_driver_flags "${words[@]}"
}

# Compile one source with both Make and literal include inventories for independent checking.
compile() {
    local source=$1 object=$2
    shift 2
    if ! style_driver_run "$root/build/driver.cfg" "$FERN_STYLE_CC" "$@" -MD -MF "$object.d" -MT fern-object -H \
         -c "$source" -o "$object" > "$object.stdout" 2> "$object.includes"; then
        printf 'fern style: compiler failed; last 8192 diagnostic bytes follow\n' >&2
        /usr/bin/tail -c 8192 -- "$object.includes" >&2
        return 125
    fi
    "$FERN_STYLE_METADATA" deps < "$object.d" > "$object.dep.paths"
    "$FERN_STYLE_METADATA" includes < "$object.includes" > "$object.include.paths"
}

# Trace every native link input; the cache validates actual resolved files, not only flags.
link() {
    local output=$1
    shift
    style_driver_run "$root/build/driver.cfg" "$FERN_STYLE_CC" "$@" -Wl,-t -o "$output" > "$output.link.paths"
}

# Keep source selection aligned with the authored build variables, rejecting unknown globs.
source_contract() {
    local name=$1 expected=$2
    configuration "$name"
    [[ ${#words[@]} == 1 && ${words[0]} == "$expected" ]] || {
        printf 'fern style: unsupported source inventory: %s\n' "$name" >&2
        return 125
    }
}

# Build frontend and reusable QBE driver from the same vendored backend objects.
frontend() {
    local source object relative
    local frontend_objects=() qbe_objects=()
    for source in src/*.c lib/*.c; do
        object="build/frontend_${source//\//_}.o"
        compile "$source" "$object" "${base[@]}" "${mode[@]}"
        frontend_objects+=("$object")
    done
    for source in "${qbe_sources[@]}"; do
        [[ $source == deps/qbe/*.c && -f $source ]] || return 125
        relative=${source#deps/qbe/}
        object="build/qbe_${relative//\//_}.o"
        compile "$source" "$object" "${qbe[@]}"
        qbe_objects+=("$object")
    done
    compile deps/linenoise/linenoise.c build/linenoise.o "${linenoise[@]}"
    link bin/fern "${base[@]}" "${mode[@]}" "${frontend_objects[@]}" \
        "${qbe_objects[@]}" build/linenoise.o -lm
    compile compiler-rs/backend/qbe_driver.c build/driver.o "${base[@]}"
    link bin/fern-qbe "${base[@]}" build/driver.o "${qbe_objects[@]}" -lm
}

# Build the existing runtime using exact parsed external include arguments.
runtime() {
    local source object
    local objects=()
    for source in runtime/*.c; do
        object="build/runtime_${source//\//_}.o"
        compile "$source" "$object" "${base[@]}" "${mode[@]}" "${gc_flags[@]}" \
            -Iruntime -Ideps/civetweb/include
        objects+=("$object")
    done
    compile deps/civetweb/src/civetweb.c build/runtime_civetweb.o \
        "${civetweb[@]}" "${mode[@]}" "${ssl_flags[@]}"
    compile deps/linenoise/linenoise.c build/runtime_linenoise.o "${linenoise[@]}" "${mode[@]}"
    objects+=(build/runtime_civetweb.o build/runtime_linenoise.o)
    "$FERN_STYLE_AR" rcs bin/libfern_runtime.a "${objects[@]}"
}

# Emit via the C frontend, then perform all assembly/link work with literal argv.
checker() {
    local gc_dir
    bin/fern emit scripts/check_style.fn > build/checker.ssa
    bin/fern-qbe build/checker.ssa build/checker.s
    style_driver_run "$root/build/driver.cfg" "$FERN_STYLE_CC" -c build/checker.s -o build/checker.o
    "$FERN_STYLE_PKG_CONFIG" --variable=libdir bdw-gc > build/gc.libdir
    IFS= read -r gc_dir < build/gc.libdir
    [[ $gc_dir == /* && -f "$gc_dir/libgc.a" ]] || return 125
    pkg_flags sqlite3 --libs
    local sqlite=("${words[@]}")
    pkg_flags openssl --libs
    local ssl=("${words[@]}")
    link bin/check_style build/checker.o bin/libfern_runtime.a "$gc_dir/libgc.a" \
        "${sqlite[@]}" "${ssl[@]}" -pthread
}

source_contract src_sources 'src/*.c'
source_contract lib_sources 'lib/*.c'
source_contract runtime_sources 'runtime/*.c'
configuration base_cflags; style_driver_flags "${words[@]}"; base=("${words[@]}")
configuration debug_flags; style_driver_flags "${words[@]}"; mode=("${words[@]}")
configuration qbe_cflags; style_driver_flags "${words[@]}"; qbe=("${words[@]}")
configuration linenoise_cflags; style_driver_flags "${words[@]}"; linenoise=("${words[@]}")
configuration civetweb_cflags; style_driver_flags "${words[@]}"; civetweb=("${words[@]}")
configuration qbe_sources; qbe_sources=("${words[@]}")
pkg_flags bdw-gc --cflags; gc_flags=("${words[@]}")
pkg_flags openssl --cflags; ssl_flags=("${words[@]}")
frontend
runtime
checker
# Record effective search roots and the actual compiler process identity for cache validation.
style_driver_run "$root/build/driver.cfg" "$FERN_STYLE_CC" "${base[@]}" "${gc_flags[@]}" "${ssl_flags[@]}" \
    -E -v -x c /dev/null > build/search.stdout 2> build/search.stderr
style_driver_run "$root/build/driver.cfg" "$FERN_STYLE_CC" -print-search-dirs > build/compiler.search-dirs
