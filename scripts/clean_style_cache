#!/bin/bash
# Explicitly clear completed native style bundles without deleting active/incomplete invocations.
set -o pipefail
[[ $# == 0 ]] || { printf 'usage: clean_style_cache\n' >&2; exit 125; }
umask 077
export LC_ALL=C
style_root=$(cd -P -- "${BASH_SOURCE[0]%/*}/.." && pwd) || exit 125
style_tool_path=${FERN_STYLE_TOOL_PATH-$PATH}
export PATH=$style_tool_path
source "$style_root/scripts/bootstrap/style_common.sh" || exit 125
style_close_descriptors || exit 125
source "$style_root/scripts/bootstrap/style_inputs.sh" || exit 125
source "$style_root/scripts/bootstrap/style_cache.sh" || exit 125
style_requested_cache=${FERN_STYLE_CACHE-${XDG_CACHE_HOME:-${HOME:?}/.cache}/fern-style}
[[ -e $style_requested_cache || -L $style_requested_cache ]] || exit 0
style_platform=$(/usr/bin/uname -s) || exit 125
style_uid=$(/usr/bin/id -u) || exit 125
style_stat_tool=$(style_tool stat) || exit 125
style_openssl=$(style_tool openssl) || exit 125
style_cache_root "$style_requested_cache" || {
    printf 'fern style: invalid cache ownership\n' >&2 || :
    exit 125
}
style_clear || {
    printf 'fern style: cache cleanup failed\n' >&2 || :
    exit 125
}
